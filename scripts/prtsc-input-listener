#!/usr/bin/env python3
"""
Listen for Print Screen key at the kernel input (evdev) level,
bypassing X11 keyboard grabs from popup menus.

Only listens on ONE device per physical keyboard to avoid duplicate
events from USB receivers that expose multiple input event nodes.
"""

import evdev
import os
import subprocess
import sys
import time
from evdev.ecodes import EV_KEY, KEY_SYSRQ

# ── configuration ──────────────────────────────────────────────
USER          = "arch"
UID           = 1000
GID           = 1000
SCRIPT        = f"/home/{USER}/.local/bin/prtsc-screenshot.sh"
DEBOUNCE_SEC  = 1.5

# Listen on event14 (Compx 2.4G Wireless Receiver Keyboard).
# We intentionally skip event10 (same receiver, secondary iface)
# because a single key press generates events on both, causing
# double-trigger.  We also skip event5 (mouse) and event3 (built-in
# AT keyboard — the wireless keyboard is the primary input device).
DEVICE_PATH = "/dev/input/event3"

# Fallback: if event14 isn't available, try these in order.
FALLBACK_PATHS = [
    "/dev/input/event14",
    "/dev/input/event10",
]
# ────────────────────────────────────────────────────────────────

last_trigger_time = 0.0


def trigger() -> None:
    """Run the screenshot script as the desktop user (drop root)."""
    global last_trigger_time

    now = time.monotonic()
    if now - last_trigger_time < DEBOUNCE_SEC:
        return
    last_trigger_time = now

    # Resolve XAUTHORITY: LightDM stores the active session cookie at
    # /run/lightdm/<user>/xauthority (regenerated each login).  Fall
    # back to ~/.Xauthority for non-LightDM setups.
    xauth = f"/run/lightdm/{USER}/xauthority"
    if not os.path.exists(xauth):
        xauth = f"/home/{USER}/.Xauthority"

    env = {
        "DISPLAY": ":0",
        "XAUTHORITY": xauth,
        "HOME": f"/home/{USER}",
        "XDG_RUNTIME_DIR": f"/run/user/{UID}",
        "PATH": "/usr/local/bin:/usr/bin:/bin",
        "LANG": "en_US.UTF-8",
        "LC_ALL": "en_US.UTF-8",
    }
    try:
        subprocess.Popen(
            [SCRIPT],
            env=env,
            preexec_fn=lambda: (os.setgid(GID), os.setuid(UID)),
        )
    except Exception as exc:
        print(f"[prtsc-listener] trigger failed: {exc}", file=sys.stderr)


def resolve_device() -> str | None:
    """Return the first available input device with the Print key."""
    candidates = [DEVICE_PATH] + FALLBACK_PATHS
    for path in candidates:
        if os.path.exists(path):
            return path
    return None


def main() -> None:
    device_path = resolve_device()
    if device_path is None:
        print("[prtsc-listener] no input device found — exiting", file=sys.stderr)
        sys.exit(1)

    print(f"[prtsc-listener] listening on {device_path}", file=sys.stderr)

    while True:
        try:
            dev = evdev.InputDevice(device_path)
            for event in dev.read_loop():
                if event.type == EV_KEY and event.code == KEY_SYSRQ:
                    if event.value == 1:          # key-down only
                        trigger()
        except (OSError, PermissionError) as exc:
            print(f"[prtsc-listener] {device_path}: {exc} — retrying in 3s",
                  file=sys.stderr)
            time.sleep(3)
        except Exception as exc:
            print(f"[prtsc-listener] {device_path}: {exc}", file=sys.stderr)
            raise


if __name__ == "__main__":
    main()
