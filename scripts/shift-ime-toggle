#!/usr/bin/env python3
"""Monitor keyboards for Left Shift tap → toggle fcitx5 IME.

Listens at evdev level (below Wayland/X11), so it functions regardless of
compositor support for input-method protocol.

A "tap" is a Left-Shift press & release within 200 ms, with no other key
pressed during the interval.  Normal Shift-as-modifier is unaffected.
"""

import os
import subprocess
import sys
import threading
import time

import evdev
from evdev import ecodes

# ── config ──────────────────────────────────────────────────────────
TAP_TIMEOUT_MS    = 200      # max ms between press and release
DEBOUNCE_MS       = 400      # cross-keyboard cooldown (handles multi-device echoes)
SCAN_INTERVAL     = 5.0      # seconds between device rescans

# ── toggle (idempotent: read state, set opposite) ────────────────────

def _fcitx5_remote(*args):
    """Run fcitx5-remote as the desktop user, return stdout."""
    cmd = ["fcitx5-remote"] + list(args)
    if os.geteuid() == 0:
        cmd = [
            "sudo", "-u", "arch",
            "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus",
        ] + cmd
    r = subprocess.run(cmd, timeout=2, capture_output=True, text=True)
    return r.stdout.strip()


def run_toggle():
    """Read current IME state and flip it — idempotent, safe for double triggers."""
    try:
        state = _fcitx5_remote()           # "0"=closed, "1"=inactive(EN), "2"=active(CN)
        if state in ("0", "1"):
            _fcitx5_remote("-c")           # activate → 中文
            print("  IME → 中", file=sys.stderr, flush=True)
        else:                               # state == "2"
            _fcitx5_remote("-o")           # inactivate → English
            print("  IME → EN", file=sys.stderr, flush=True)
    except Exception:
        pass


# ── per-keyboard monitor ────────────────────────────────────────────

class KeyboardWatcher:
    """Read events from one keyboard device, emit tap callbacks."""

    def __init__(self, path, on_tap):
        self.path   = path
        self.on_tap = on_tap
        self._stop  = threading.Event()
        self._shift_down_at = 0.0
        self._other_held: set[int] = set()

    def stop(self):
        self._stop.set()

    def run(self):
        """Blocking read_loop — run in a thread."""
        while not self._stop.is_set():
            try:
                dev = evdev.InputDevice(self.path)
            except Exception as exc:
                print(f"  {self.path}: {exc} — retrying", file=sys.stderr)
                self._stop.wait(SCAN_INTERVAL)
                continue
            try:
                for ev in dev.read_loop():
                    if self._stop.is_set():
                        break
                    if ev.type != ecodes.EV_KEY:
                        continue
                    code = ev.code
                    if code == ecodes.KEY_LEFTSHIFT:
                        if ev.value == 1:                          # press
                            self._shift_down_at = time.monotonic()
                        elif ev.value == 0 and self._shift_down_at:  # release
                            elapsed = (time.monotonic() - self._shift_down_at) * 1000
                            if 0 < elapsed < TAP_TIMEOUT_MS and not self._other_held:
                                self.on_tap()
                            self._shift_down_at = 0.0
                            self._other_held.clear()
                    else:
                        if ev.value == 1:
                            self._other_held.add(code)
                        elif ev.value == 0:
                            self._other_held.discard(code)
            except (OSError, PermissionError) as exc:
                print(f"  {self.path}: {exc} — reconnecting", file=sys.stderr)
                try:
                    dev.close()
                except Exception:
                    pass
                self._stop.wait(1)
            except Exception:
                try:
                    dev.close()
                except Exception:
                    pass
                self._stop.wait(1)


# ── device filter ───────────────────────────────────────────────────

def is_real_keyboard(dev_path):
    """Only accept devices whose name includes 'keyboard' or 'AT Translated'."""
    try:
        dev = evdev.InputDevice(dev_path)
    except Exception:
        return False
    caps = dev.capabilities().get(ecodes.EV_KEY, [])
    name = dev.name.lower()
    dev.close()
    if not caps:
        return False
    codes = {c[0] if isinstance(c, tuple) else c for c in caps}
    if not (ecodes.KEY_A in codes and ecodes.KEY_SPACE in codes):
        return False
    if "keyboard" not in name and "at translated" not in name:
        return False
    return True


# ── main ────────────────────────────────────────────────────────────

def main():
    # Debounce — shared across all keyboards
    last_fire = 0.0
    lock = threading.Lock()

    def on_tap():
        nonlocal last_fire
        now = time.monotonic()
        with lock:
            if now - last_fire < (DEBOUNCE_MS / 1000.0):
                return
            last_fire = now
        run_toggle()

    threads: list[threading.Thread] = []
    known_paths: set[str] = set()

    print("shift-ime-toggle: starting (idempotent toggle, {} ms debounce)".format(
        DEBOUNCE_MS), file=sys.stderr)

    try:
        while True:
            current = set(evdev.list_devices())
            for path in sorted(current - known_paths):
                if not os.path.exists(path):
                    continue
                if is_real_keyboard(path):
                    print(f"  + {path}", file=sys.stderr)
                    kw = KeyboardWatcher(path, on_tap)
                    t = threading.Thread(target=kw.run, daemon=True)
                    t.start()
                    threads.append(t)
                    known_paths.add(path)

            # Prune dead threads
            threads = [t for t in threads if t.is_alive()]
            known_paths &= current

            time.sleep(SCAN_INTERVAL)
    except KeyboardInterrupt:
        print("\nshift-ime-toggle: stopped", file=sys.stderr)


if __name__ == "__main__":
    main()
